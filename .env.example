NODE_ENV=development
DEMO_AUTO_CONFIRM_EMAIL=false
PORT=3000
SUPABASE_URL=https://your-project.supabase.co
# Solo servidor: usar una clave secreta real únicamente en el gestor de variables del entorno.
SUPABASE_SECRET_KEY=your-supabase-secret-key
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-the-secret-manager
ADMIN_NAME=DREAMS Admin
CONTACT_EMAIL=contacto@example.com
WHATSAPP_NUMBER=5490000000000
# Orígenes públicos exactos, separados por coma. Actualizar antes de cambiar de dominio.
APP_ORIGINS=http://localhost:3000
APP_BASE_URL=http://localhost:3000
# `demo` habilita la simulación interna; `mercado_pago` conserva Checkout Pro.
CHECKOUT_PROVIDER=demo
MERCADO_PAGO_MODE=sandbox
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
# Activar sólo después de aplicar y verificar la migración de pedidos.
CHECKOUT_SCHEMA_READY=false
CHECKOUT_SHOW_TEST_DATA=true

# Isolated academic checkout: signed references, no commercial orders.
PRESENTATION_CHECKOUT_ENABLED=false
PRESENTATION_SIGNING_KEY=
PREVIEW_READ_ONLY=false
# Turn on only after provider, allowed callbacks and Google account flow are verified.
GOOGLE_ACCESS_READY=false
