NODE_ENV=development
DEMO_AUTO_CONFIRM_EMAIL=false
PORT=8080
SUPABASE_URL=https://your-project.supabase.co
# solo servidor: cargar la clave mediante el gestor seguro, nunca en el navegador.
SUPABASE_SECRET_KEY=your-supabase-secret-key
CONTACT_EMAIL=contacto@example.com
WHATSAPP_NUMBER=5490000000000
# origenes exactos separados por coma; deben coincidir con el entorno usado.
APP_ORIGINS=http://localhost:8080
APP_BASE_URL=http://localhost:8080
# simulacion academica: referencias firmadas sin cobros ni pedidos comerciales.
PRESENTATION_CHECKOUT_ENABLED=false
PRESENTATION_SIGNING_KEY=
PREVIEW_READ_ONLY=false
# google requiere configuracion y comprobacion del proveedor antes de habilitarse.
GOOGLE_ACCESS_READY=false

# carrito por cuenta: usar una clave local de al menos 32 caracteres o la de presentacion.
ACCOUNT_CART_ENABLED=false
ACCOUNT_CART_SIGNING_KEY=
