    "constraints": [
      {
        "schema": "public",
        "conname": "account_cart_operations_pkey",
        "contype": "p",
        "definition": "PRIMARY KEY (user_id, operation_id)",
        "table_name": "account_cart_operations"
      },
      {
        "schema": "public",
        "conname": "account_cart_operations_user_id_fkey",
        "contype": "f",
        "definition": "FOREIGN KEY (user_id) REFERENCES account_carts(user_id) ON DELETE CASCADE",
        "table_name": "account_cart_operations"
      },
      {
        "schema": "public",
        "conname": "account_carts_items_check",
        "contype": "c",
        "definition": "CHECK (((jsonb_typeof(items) = 'array'::text) AND (jsonb_array_length(items) <= 30)))",
        "table_name": "account_carts"
      },
      {
        "schema": "public",
        "conname": "account_carts_pkey",
        "contype": "p",
        "definition": "PRIMARY KEY (user_id)",
        "table_name": "account_carts"
      },
      {
        "schema": "public",
        "conname": "account_carts_revision_check",
        "contype": "c",
        "definition": "CHECK ((revision >= 0))",
        "table_name": "account_carts"
      },
      {
        "schema": "public",
        "conname": "account_carts_user_id_fkey",
        "contype": "f",
        "definition": "FOREIGN KEY (user_id) REFERENCES auth.users(id) ON DELETE CASCADE",
        "table_name": "account_carts"
      },
      {
        "schema": "public",
        "conname": "coupons_code_format",
        "contype": "c",
        "definition": "CHECK (((code = upper(code)) AND (code ~ '^[A-Z0-9_-]{3,40}$'::text)))",
        "table_name": "coupons"
      },
      {
        "schema": "public",
        "conname": "coupons_code_key",
        "contype": "u",
        "definition": "UNIQUE (code)",
        "table_name": "coupons"
      },
      {
        "schema": "public",
        "conname": "coupons_conditions_object",
        "contype": "c",
        "definition": "CHECK ((jsonb_typeof(conditions) = 'object'::text))",
        "table_name": "coupons"
      },
      {
        "schema": "public",
        "conname": "coupons_discount_range",
        "contype": "c",
        "definition": "CHECK (((discount_percent > (0)::numeric) AND (discount_percent <= (100)::numeric)))",
        "table_name": "coupons"
      },
      {
        "schema": "public",
        "conname": "coupons_max_uses_positive",
        "contype": "c",
        "definition": "CHECK (((max_uses IS NULL) OR (max_uses > 0)))",
        "table_name": "coupons"
      },
      {
