digraph DER {
graph [rankdir=LR, bgcolor="white", label="DREAMS · D.E.R. remoto verificado03/11/2026 · sólo metadatos", labelloc=t, fontname="DejaVu Sans", fontsize=22, nodesep=.5, ranksep=1];
node [shape=plain,fontname="DejaVu Sans"]; edge [fontname="DejaVu Sans",fontsize=11];
auth_users [label=<<TABLE BORDER="1" CELLBORDER="0"><TR><TD BGCOLOR="#dce4ed"><B>auth.users · proveedor Auth</B></TD></TR><TR><TD ALIGN="LEFT">PK id : uuid</TD></TR><TR><TD ALIGN="LEFT">Resto de campos no consultados</TD></TR></TABLE>>];
account_cart_operations [label=<<TABLE BORDER="1" CELLBORDER="0" CELLPADDING="6"><TR><TD BGCOLOR="#e2eddf"><B>public.account_cart_operations · ACTIVA</B></TD></TR><TR><TD ALIGN="LEFT">PK FK user_id : uuid NOT NULL</TD></TR><TR><TD ALIGN="LEFT">PK operation_id : uuid NOT NULL</TD></TR><TR><TD ALIGN="LEFT">operation : jsonb NOT NULL</TD></TR><TR><TD ALIGN="LEFT">created_at : timestamptz NOT NULL</TD></TR><TR><TD ALIGN="LEFT">PK compuesta: user_id, operation_id</TD></TR></TABLE>>];
account_carts -> account_cart_operations [dir=both,arrowtail=none,arrowhead=none,taillabel="1",headlabel="0..N",label="user_id → user_id",color="#566d83"];
account_carts [label=<<TABLE BORDER="1" CELLBORDER="0" CELLPADDING="6"><TR><TD BGCOLOR="#e2eddf"><B>public.account_carts · ACTIVA</B></TD></TR><TR><TD ALIGN="LEFT">PK FK user_id : uuid NOT NULL</TD></TR><TR><TD ALIGN="LEFT">items : jsonb NOT NULL</TD></TR><TR><TD ALIGN="LEFT">revision : int8 NOT NULL</TD></TR><TR><TD ALIGN="LEFT">updated_at : timestamptz NOT NULL</TD></TR></TABLE>>];
auth_users -> account_carts [dir=both,arrowtail=none,arrowhead=none,taillabel="1",headlabel="0..1",label="user_id → id",color="#566d83"];
