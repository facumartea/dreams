favorites [label=<<TABLE BORDER="1" CELLBORDER="0" CELLPADDING="6"><TR><TD BGCOLOR="#eeeeee"><B>public.favorites · HISTÓRICA</B></TD></TR><TR><TD ALIGN="LEFT">PK FK user_id : uuid NOT NULL</TD></TR><TR><TD ALIGN="LEFT">PK FK product_id : int8 NOT NULL</TD></TR><TR><TD ALIGN="LEFT">created_at : timestamptz NOT NULL</TD></TR><TR><TD ALIGN="LEFT">PK compuesta: user_id, product_id</TD></TR></TABLE>>];
