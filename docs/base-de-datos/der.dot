profiles [label=<<TABLE BORDER="1" CELLBORDER="0" CELLPADDING="6"><TR><TD BGCOLOR="#e2eddf"><B>public.profiles · ACTIVA</B></TD></TR><TR><TD ALIGN="LEFT">PK FK id : uuid NOT NULL</TD></TR><TR><TD ALIGN="LEFT">name : text NOT NULL</TD></TR><TR><TD ALIGN="LEFT">role : text NOT NULL</TD></TR><TR><TD ALIGN="LEFT">created_at : timestamptz NOT NULL</TD></TR></TABLE>>];
